# =============================================================================
# Environment Variables Template — Framework Agéntico
# =============================================================================
# Copy this file to `.env` and fill in your real values.
# The `.env` file is gitignored and should NEVER be committed.
#
# Variables marked with [REQUIRED] are needed for the corresponding MCP to work
# when `enabled: true`. Variables for disabled MCPs are optional until you
# enable them.
#
# See: .opencode/docs/mcp-setup.md for detailed setup instructions.
# =============================================================================


# -----------------------------------------------------------------------------
# GitHub MCP - NO requiere token: usa OAuth remoto (https://api.githubcopilot.com/mcp/)
# Primer login: `opencode mcp auth github` (una vez, en el browser).
# Verificacion: `opencode mcp list` / `opencode mcp debug github`.


# -----------------------------------------------------------------------------
# PostgreSQL MCP — REQUIRED when postgres MCP is enabled
# -----------------------------------------------------------------------------
# Default local dev: postgresql://postgres:postgres@localhost:5432/postgres
# Can also use a docker container started with the framework's docker-compose.
POSTGRES_CONNECTION_STRING=<your-postgres-connection-string>


# -----------------------------------------------------------------------------
# Notion MCP — REQUIRED only if you enable the notion MCP
# -----------------------------------------------------------------------------
# Get one at: https://www.notion.so/profile/integrations
# Create an internal integration and copy the "Internal Integration Secret".
# Format: ntn_ followed by ~50 alphanumeric characters
NOTION_TOKEN=<your-notion-integration-token>


# -----------------------------------------------------------------------------
# Google Cloud MCPs — REQUIRED only if you enable gcloud/observability MCPs
# -----------------------------------------------------------------------------
# Path to a service account JSON key file.
# Create one at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Required roles for observability: roles/monitoring.viewer, roles/logging.viewer
# Required roles for gcloud: depends on operations, start with roles/editor for dev
GOOGLE_APPLICATION_CREDENTIALS=<absolute-path-to-service-account.json>


# -----------------------------------------------------------------------------
# Prometheus MCP — REQUIRED only if you enable the prometheus MCP
# -----------------------------------------------------------------------------
# Default local URL when running Prometheus in docker.
# To start locally: docker run -d -p 9090:9090 prom/prometheus
PROMETHEUS_URL=http://localhost:9090


# -----------------------------------------------------------------------------
# Grafana MCP — REQUIRED only if you enable the grafana MCP
# -----------------------------------------------------------------------------
# Default local URL when running Grafana in docker.
# To start locally: docker run -d -p 3000:3000 grafana/grafana
GRAFANA_URL=http://localhost:3000
# Create one in Grafana: Configuration -> API Keys -> New API Key
GRAFANA_API_KEY=<your-grafana-api-key>


# -----------------------------------------------------------------------------
# Automation-safe MCP — RESERVED for future use
# -----------------------------------------------------------------------------
# This MCP is intentionally a placeholder. It is reserved for sandboxed
# automation integrations (e.g., safe browser automation, controlled deploys).
# Do not configure until the integration is defined.
AUTOMATION_TOKEN=<reserved-not-used-yet>
