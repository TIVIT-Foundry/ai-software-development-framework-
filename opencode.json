{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": [
    "AGENTS.md",
    ".opencode/AGENT-ONBOARDING.md"
  ],
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": true
    },
    "docker": {
      "type": "local",
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run"
      ],
      "enabled": true
    },
    "package-registry": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "package-registry-mcp"
      ],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        ".opencode"
      ],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,actions,users"
      }
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres"
      ],
      "enabled": true,
      "environment": {
        "POSTGRES_CONNECTION_STRING": "{env:POSTGRES_CONNECTION_STRING}"
      }
    },
    "notion": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "enabled": false,
      "environment": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\":\"Bearer {env:NOTION_TOKEN}\",\"Notion-Version\":\"2025-09-03\"}"
      }
    },
    "gcloud": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@google-cloud/gcloud-mcp"
      ],
      "enabled": false,
      "environment": {
        "GOOGLE_APPLICATION_CREDENTIALS": "{env:GOOGLE_APPLICATION_CREDENTIALS}"
      }
    },
    "observability": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@google-cloud/observability-mcp"
      ],
      "enabled": false,
      "environment": {
        "GOOGLE_APPLICATION_CREDENTIALS": "{env:GOOGLE_APPLICATION_CREDENTIALS}"
      }
    }
  },
  "permission": {
    "edit": {
      ".opencode/framework/**": "ask",
      ".opencode/agents/**": "ask",
      "*": "allow"
    },
    "bash": {
      "git *": "allow",
      "rm *": "ask",
      "*": "ask"
    },
    "external_directory": {
      "~/.config/opencode/**": "deny",
      "**/node_modules/**": "deny",
      "*": "allow"
    }
  }
}
