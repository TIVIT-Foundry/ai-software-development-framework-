import { sql } from './${entity}.db';
import type {
  ${ENTITY}Create,
  ${ENTITY}Update,
  ${ENTITY}QueryParams,
} from './${entity}.dto';

export async function list${ENTITIES}(params: ${ENTITY}QueryParams) {
  const {
    page = 1,
    pageSize = 20,
    sortBy = 'created_at',
    sortOrder = 'DESC',
    searchFilter,
  } = params;
  const offset = (page - 1) * pageSize;

  const searchClause = searchFilter
    ? sql`AND (CAST(id AS TEXT) ILIKE ${`%${searchFilter}%`} OR title ILIKE ${`%${searchFilter}%`})`
    : sql``;

  const items = await sql`
    SELECT *
    FROM ${sql.unsafe('${SCHEMA}')}.${sql.unsafe('${TABLE}')}
    WHERE record_status = 'A'
    ${searchClause}
    ORDER BY ${sql.unsafe(sortBy)} ${sql.unsafe(sortOrder)}
    LIMIT ${pageSize}
    OFFSET ${offset}
  `;

  const [{ count }] = await sql`
    SELECT COUNT(*) AS count
    FROM ${sql.unsafe('${SCHEMA}')}.${sql.unsafe('${TABLE}')}
    WHERE record_status = 'A'
    ${searchClause}
  `;

  return {
    items,
    total: Number(count),
    page,
    pageSize,
  };
}

export async function get${ENTITY}(id: number) {
  const [item] = await sql`
    SELECT * FROM ${sql.unsafe('${SCHEMA}')}.${sql.unsafe('${TABLE}')}
    WHERE id = ${id} AND record_status = 'A'
  `;
  return item ?? null;
}

export async function create${ENTITY}(data: ${ENTITY}Create) {
  const [item] = await sql`
    INSERT INTO ${sql.unsafe('${SCHEMA}')}.${sql.unsafe('${TABLE}')} (
      ${sql.unsafe('${SQL_INSERT_COLS_CSV}')},
      created_by
    ) VALUES (
      ${sql.unsafe('${SQL_VALUES_PLACEHOLDERS_CSV}')},
      1
    )
    RETURNING *
  `;
  return item;
}

export async function update${ENTITY}(id: number, data: ${ENTITY}Update) {
  const [item] = await sql`
    UPDATE ${sql.unsafe('${SCHEMA}')}.${sql.unsafe('${TABLE}')}
    SET
      ${sql.unsafe('${SQL_UPDATE_SET_CSV}')},
      updated_at = NOW(),
      updated_by = 1
    WHERE id = ${id} AND record_status = 'A'
    RETURNING *
  `;
  return item ?? null;
}

export async function delete${ENTITY}(id: number) {
  const result = await sql`
    UPDATE ${sql.unsafe('${SCHEMA}')}.${sql.unsafe('${TABLE}')}
    SET record_status = 'I', updated_at = NOW(), updated_by = 1
    WHERE id = ${id} AND record_status = 'A'
  `;
  return result.count > 0;
}
