import { useState } from 'react';

import { ${ENTITY}Table } from './${entity}-table';
import type { ${ENTITY}ListItem } from './${entity}.model';

interface ${ENTITY}ListProps {
  items: ${ENTITY}ListItem[];
  total: number;
  page: number;
  pageSize: number;
  loading?: boolean;
  error?: string | null;
  onSearch: (value: string) => void;
  onPageChange: (page: number) => void;
  onSortChange: (sort: { sortBy: string; sortOrder: 'ASC' | 'DESC' }) => void;
  onCreate: () => void;
  onEdit: (id: number) => void;
  onDelete: (id: number) => void;
}

export function ${ENTITY}List({
  items,
  total,
  page,
  pageSize,
  loading = false,
  error = null,
  onSearch,
  onPageChange,
  onSortChange,
  onCreate,
  onEdit,
  onDelete,
}: ${ENTITY}ListProps) {
  const [searchValue, setSearchValue] = useState('');

  return (
    <div className="${entity}-list">
      <div className="toolbar">
        <input
          type="search"
          placeholder="Search ${entities}..."
          value={searchValue}
          onChange={(e) => setSearchValue(e.target.value)}
          onKeyUp={(e) => e.key === 'Enter' && onSearch(searchValue)}
        />
        <button type="button" onClick={onCreate}>New ${ENTITY}</button>
      </div>

      {error && <div className="error">{error}</div>}

      <${ENTITY}Table
        items={items}
        total={total}
        page={page}
        pageSize={pageSize}
        loading={loading}
        onPageChange={onPageChange}
        onSortChange={onSortChange}
        onEdit={onEdit}
        onDelete={onDelete}
      />

      {loading && <div className="loading">Loading...</div>}
    </div>
  );
}
