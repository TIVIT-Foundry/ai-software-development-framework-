import { Component, input, output, OnInit, OnDestroy, inject } from '@angular/core';
import { FormBuilder, FormGroup, ReactiveFormsModule, Validators } from '@angular/forms';
import { Subject } from 'rxjs';

import type { ${ENTITY}CreateRequest, ${ENTITY}UpdateRequest } from './${entity}.model';

@Component({
  selector: 'app-${entity}-form',
  standalone: true,
  imports: [ReactiveFormsModule],
  templateUrl: './${entity}-form.component.html',
})
export class ${ENTITY}FormComponent implements OnInit, OnDestroy {
  private readonly fb = inject(FormBuilder);
  private readonly destroy$ = new Subject<void>();

  readonly initialValues = input<${ENTITY}UpdateRequest | null>(null);
  readonly loading = input<boolean>(false);

  readonly submitForm = output<${ENTITY}CreateRequest | ${ENTITY}UpdateRequest>();
  readonly cancel = output<void>();

  form!: FormGroup;

  ngOnInit(): void {
    this.buildForm();
  }

  ngOnDestroy(): void {
    this.destroy$.next();
    this.destroy$.complete();
  }

  private buildForm(): void {
    const values = this.initialValues();
    this.form = this.fb.group({
$FORM_CONTROLS
    });
  }

  onSubmit(): void {
    if (this.form.invalid) {
      this.form.markAllAsTouched();
      return;
    }
    this.submitForm.emit(this.form.value);
  }
}
