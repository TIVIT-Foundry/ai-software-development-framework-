<form [formGroup]="form" (ngSubmit)="onSubmit()" class="${entity}-form">
  <h3>{{ initialValues() ? 'Edit' : 'Create' }} ${ENTITY}</h3>

$FORM_FIELDS

  <div class="actions">
    <button type="submit" [disabled]="loading()">
      {{ loading() ? 'Saving...' : 'Save' }}
    </button>
    <button type="button" (click)="cancel.emit()">Cancel</button>
  </div>
</form>
