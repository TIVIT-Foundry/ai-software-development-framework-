<div class="${entity}-table">
  @if (items().length === 0 && !loading()) {
    <p>No ${entities} found</p>
  } @else {
    <table>
      <thead>
        <tr>
$TABLE_HEADERS
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        @for (item of items(); track item.id) {
          <tr>
$TABLE_CELLS
            <td>
              <button type="button" (click)="edit.emit(item.id)">Edit</button>
              <button type="button" (click)="delete.emit(item.id)">Delete</button>
            </td>
          </tr>
        }
      </tbody>
    </table>
  }

  <div class="pagination">
    <button [disabled]="page() <= 1" (click)="pageChange.emit(page() - 1)">Previous</button>
    <span>Page {{ page() }} of {{ totalPages() }}</span>
    <button [disabled]="page() >= totalPages()" (click)="pageChange.emit(page() + 1)">Next</button>
  </div>
</div>
