# EXPOSE 8000
#
# HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
#     CMD curl -f http://localhost:8000/health || exit 1
#
# CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# ╔══════════════════════════════════════════════════════════════╗
# ║  DEVELOPMENT STAGE (docker build --target dev)              ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Build: docker build --target dev -t myapp-api:dev -f Dockerfile .
# Run:   docker run -p 8000:8000 -v ${PWD}/src:/app/src myapp-api:dev

FROM runtime AS dev
USER root

# Install dev tools
RUN pip install --no-cache-dir \
    debugpy \
    watchfiles \
    pytest \
    pytest-cov \
    pytest-asyncio

# Switch back to appuser
USER appuser

# Enable hot reload with watchfiles
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "app/"]

# ╔══════════════════════════════════════════════════════════════╗
# ║  MIGRATIONS STAGE — runs Alembic, then exits               ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Build: docker build --target migrations -t myapp-migrations -f Dockerfile .
# Run:   docker run --env-file .env myapp-migrations

FROM runtime AS migrations
USER root
RUN pip install --no-cache-dir alembic
USER appuser
COPY --chown=appuser:appgroup alembic.ini migrations/ ./
ENTRYPOINT ["alembic", "upgrade", "head"]
